# Local: instala Postgres y usa algo como
#   postgresql://postgres:postgres@localhost:5432/ccaa_dev
# En Vercel: la Storage integration (Postgres/Neon) te da esta URL directamente.
DATABASE_URL=""

# Genera uno propio con: npx auth secret  (o `openssl rand -base64 32`)
AUTH_SECRET=""

# Necesario cuando se despliega detrás de un proxy/host propio (no Vercel).
AUTH_TRUST_HOST=true

# Punto de integración para el informe IA (Milestone 4). No hardcodear la key.
ANTHROPIC_API_KEY=""
