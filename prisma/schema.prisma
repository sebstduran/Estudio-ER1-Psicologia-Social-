// Schema de datos del Instrumento CCAA — EPG
// Ver AGENTS.md del proyecto para contexto institucional.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // En ejecución, la conexión agrupada: las funciones de Vercel abren y cierran
  // muchas conexiones cortas y el pooler es justo lo que evita agotar la base.
  url      = env("DATABASE_URL")
  // Para migrar, la conexión DIRECTA. `prisma migrate deploy` toma un cerrojo
  // de sesión (pg_advisory_lock) y el pooler de Neon trabaja por transacción,
  // así que el cerrojo expira: el despliegue falla con P1002 de forma
  // intermitente. Neon publica esta variable junto a DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Identidad ───────────────────────────────────────────────

model Coordinador {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  createdAt    DateTime @default(now())

  niveles Nivel[]
}

// ─── Catálogo institucional (fijo, no depende del coordinador) ─

// Los 7 componentes de la Estrategia Pedagógica Global.
model ComponenteEPG {
  id          String @id @default(cuid())
  orden       Int    @unique
  nombre      String
  descripcion String

  competencias Competencia[]
}

// ─── Configurar ──────────────────────────────────────────────

enum CicloTipo {
  INICIAL
  INTERMEDIO
  FINAL
}

enum Modalidad {
  DIURNO // 4 reuniones CCAA por trimestre
  VESPERTINO_TECH // 3 reuniones CCAA por trimestre
}

// Una instancia concreta: un nivel, de un coordinador, en un trimestre.
model Nivel {
  id                  String    @id @default(cuid())
  nombre              String
  // Código corto que el coordinador comparte con sus docentes. Existe para que
  // quien perdió el enlace pueda entrar igual, sin cuenta ni contraseña.
  codigo              String    @unique
  cicloTipo           CicloTipo
  modalidad           Modalidad
  trimestre           String // ej. "2026-T3"
  reunionActualNumero Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  coordinadorId String
  coordinador   Coordinador @relation(fields: [coordinadorId], references: [id], onDelete: Cascade)

  competencias Competencia[]
  asignaturas  Asignatura[]
  docentes     Docente[]
  reuniones    Reunion[]
  informes     Informe[]
  acuerdos     Acuerdo[]

  @@index([coordinadorId])
}

// Competencia de ciclo, propia de un Nivel (se clona desde la plantilla
// del Ciclo Inicial, o se define a mano para Intermedio/Final).
model Competencia {
  id          String @id @default(cuid())
  codigo      String // ej. "1.1"
  nombre      String // ej. "Fundamentar"
  descriptor  String
  orden       Int

  nivelId String
  nivel   Nivel  @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  componenteEpgId String
  componenteEpg   ComponenteEPG @relation(fields: [componenteEpgId], references: [id])

  indicadores Indicador[]
  mapeos      MapeoAsignaturaCompetencia[]
  evaluaciones Evaluacion[]
  acuerdos    Acuerdo[]

  @@unique([nivelId, codigo])
  @@index([nivelId])
}

// 3 evidencias observables por competencia.
model Indicador {
  id     String @id @default(cuid())
  texto  String
  orden  Int

  competenciaId String
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)

  evaluaciones Evaluacion[]

  @@index([competenciaId])
}

model Asignatura {
  id     String @id @default(cuid())
  nombre String

  nivelId String
  nivel   Nivel  @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  mapeos            MapeoAsignaturaCompetencia[]
  docenteAsignaturas DocenteAsignatura[]
  evaluaciones      Evaluacion[]
  percepciones      Percepcion[]

  @@index([nivelId])
}

enum TipoMapeo {
  DIRECTA
  TRANSVERSAL
}

// Ausencia de fila = "sin relación". Solo existe fila cuando hay tributación.
model MapeoAsignaturaCompetencia {
  id   String    @id @default(cuid())
  tipo TipoMapeo

  asignaturaId  String
  asignatura    Asignatura  @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  competenciaId String
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)

  @@unique([asignaturaId, competenciaId])
  @@index([competenciaId])
}

// ─── Evaluar ─────────────────────────────────────────────────

model Docente {
  id     String @id @default(cuid())
  nombre String
  email  String

  nivelId String
  nivel   Nivel  @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  asignaturas  DocenteAsignatura[]
  evaluaciones Evaluacion[]
  percepciones Percepcion[]

  @@unique([nivelId, email])
  @@index([nivelId])
}

model DocenteAsignatura {
  id String @id @default(cuid())

  docenteId    String
  docente      Docente    @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  asignaturaId String
  asignatura   Asignatura @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)

  @@unique([docenteId, asignaturaId])
}

enum FaseReunion {
  BASE // R1: línea base
  SEGUIMIENTO // reuniones intermedias
  CIERRE // última reunión de la modalidad: cierre comparativo
}

enum EstadoReunion {
  PLANIFICADA
  EN_CURSO
  CERRADA
}

model Reunion {
  id     String        @id @default(cuid())
  numero Int
  fase   FaseReunion
  fecha  DateTime?
  estado EstadoReunion @default(PLANIFICADA)

  nivelId String
  nivel   Nivel  @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  evaluaciones Evaluacion[]
  actas        Acta[]
  informes     Informe[]
  acuerdos     Acuerdo[]
  percepciones Percepcion[]

  @@unique([nivelId, numero])
  @@index([nivelId])
}

enum NivelLogro {
  LOGRADO
  EN_PROCESO
  INCIPIENTE
  // "Aún no lo trabajo": la evidencia todavía no se ve en esa asignatura.
  // No es un juicio de logro, así que queda FUERA del denominador del puntaje
  // (ver totalDe en src/lib/diagnostico.ts). Forzar un juicio sobre contenido
  // no tratado fabrica datos y puede hundir una competencia a CRÍTICO por algo
  // que sencillamente no tocaba todavía.
  NO_TRABAJADO
}

// Un voto: un docente, para una asignatura, sobre un indicador, en una reunión.
model Evaluacion {
  id         String     @id @default(cuid())
  nivelLogro NivelLogro
  comentario String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  reunionId String
  reunion   Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  docenteId String
  docente   Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  asignaturaId String
  asignatura   Asignatura @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)

  indicadorId String
  indicador   Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)

  competenciaId String
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)

  // Un docente vota una sola vez por indicador+asignatura+reunión; puede editar su voto.
  @@unique([reunionId, docenteId, asignaturaId, indicadorId])
  @@index([reunionId])
  @@index([competenciaId])
}

model Acta {
  id           String   @id @default(cuid())
  nombreArchivo String
  url          String
  subidoPor    String
  createdAt    DateTime @default(now())

  reunionId String
  reunion   Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  @@index([reunionId])
}

// Lo que el docente ve en clases y no cabe en la rúbrica. Son dos preguntas
// dirigidas y no una caja en blanco a propósito: una caja en blanco se devuelve
// en blanco. Es la materia prima que antes se perdía en el acta, así que se
// muestra al coordinador con nombre y asignatura, y alimenta el informe de IA.
model Percepcion {
  id         String   @id @default(cuid())
  dificultad String? // ¿Qué te está costando más con este curso?
  sugerencia String? // ¿Qué crees que ayudaría?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reunionId String
  reunion   Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  docenteId String
  docente   Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  asignaturaId String
  asignatura   Asignatura @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)

  // Una respuesta por docente, asignatura y reunión; puede editarla.
  @@unique([reunionId, docenteId, asignaturaId])
  @@index([reunionId])
}

// ─── Sintetizar: informe generado con IA ─────────────────────

enum EstadoInforme {
  GENERANDO
  LISTO
  ERROR
}

// Un informe corresponde a una reunión concreta del nivel: se genera con los
// datos disponibles en ese momento y queda guardado para volver a consultarlo
// sin gastar otra llamada al modelo.
model Informe {
  id        String        @id @default(cuid())
  estado    EstadoInforme @default(GENERANDO)
  // Cuerpo del informe, tal como lo devuelve el modelo (ver TipoInforme).
  contenido Json?
  error     String?
  modelo    String
  createdAt DateTime      @default(now())

  nivelId String
  nivel   Nivel  @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  reunionId String
  reunion   Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  @@index([nivelId])
  @@index([reunionId])
}

// ─── Cierre del ciclo de mejora ──────────────────────────────

enum EstadoAcuerdo {
  PENDIENTE
  EN_CURSO
  CUMPLIDO
  DESCARTADO
}

// Una recomendación solo mejora algo si alguien se hace cargo de ella. El
// acuerdo nace en una reunión, tiene responsable y plazo, y se revisa en la
// reunión siguiente: es lo que convierte el diagnóstico en mejora continua.
model Acuerdo {
  id          String        @id @default(cuid())
  texto       String
  responsable String?
  plazo       String?
  estado      EstadoAcuerdo @default(PENDIENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  nivelId String
  nivel   Nivel  @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  // Reunión en la que se acordó.
  reunionId String
  reunion   Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  // Competencia que busca fortalecer, si el acuerdo nace de una en particular.
  competenciaId String?
  competencia   Competencia? @relation(fields: [competenciaId], references: [id], onDelete: SetNull)

  @@index([nivelId])
  @@index([reunionId])
}
